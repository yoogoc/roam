/target

# Interrupted downloads (see Vfs::download_to). They are resumable state, not
# something to commit if someone downloads into the working tree.
*.roampart
*.roampart.etag

.DS_Store

# Connection profiles now carry credentials in plaintext (see docs/DESIGN.md §5).
# The real one lives in the platform config dir, but ROAM_CONFIG makes it easy to
# point at the working tree while testing — so it must never be committable.
profiles.toml
